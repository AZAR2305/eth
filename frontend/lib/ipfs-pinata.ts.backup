/**
 * Simple IPFS Service using Pinata API (no SDK needed)
 * Uses fetch() to upload directly - much lighter!
 */

export class IPFSService {
  private jwt: string;
  private gatewayUrl: string = 'https://gateway.pinata.cloud/ipfs/';

  constructor() {
    this.jwt = process.env.NEXT_PUBLIC_PINATA_JWT || '';
  }

  async uploadJSON(data: any): Promise<string> {
    try {
      if (!this.jwt) {
        console.warn('No Pinata JWT - using mock storage');
        return this.mockUpload(data);
      }

      const response = await fetch('https://api.pinata.cloud/pinning/pinJSONToIPFS', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${this.jwt}`
        },
        body: JSON.stringify({
          pinataContent: data,
          pinataMetadata: { name: `movie-${Date.now()}` }
        })
      });

      const result = await response.json();
      return result.IpfsHash;
    } catch (error) {
      console.error('Pinata upload error:', error);
      return this.mockUpload(data);
    }
  }

  async getJSON(hash: string): Promise<any> {
    try {
      const response = await fetch(`${this.gatewayUrl}${hash}`);
      return await response.json();
    } catch (error) {
      console.error('IPFS fetch error:', error);
      return this.mockGet(hash);
    }
  }

  private mockUpload(data: any): string {
    const mockHash = 'Qm' + Math.random().toString(36).substring(2, 15);
    if (typeof window !== 'undefined') {
      const stored = JSON.parse(localStorage.getItem('ipfs-data') || '{}');
      stored[mockHash] = data;
      localStorage.setItem('ipfs-data', JSON.stringify(stored));
    }
    return mockHash;
  }

  private mockGet(hash: string): any {
    if (typeof window !== 'undefined') {
      const stored = JSON.parse(localStorage.getItem('ipfs-data') || '{}');
      return stored[hash] || null;
    }
    return null;
  }
}

export const ipfsService = new IPFSService();

      const jwt = process.env.NEXT_PUBLIC_PINATA_JWT;
      
      if (jwt) {
        // Use @pinata/sdk with JWT
        this.pinata = new pinataSDK({ pinataJWTKey: jwt });
        console.log('✅ Pinata initialized');
      } else {
        console.warn('⚠️ No Pinata JWT found. Upload will fail.');
        console.warn('Get free API key from https://pinata.cloud');
        console.warn('Add NEXT_PUBLIC_PINATA_JWT to .env.local');
        this.usePublicGateway = true;
      }
    } catch (error) {
      console.error('❌ Pinata initialization error:', error);
      this.usePublicGateway = true;
    }
  }

  /**
   * Upload JSON metadata to IPFS via Pinata
   * @param data - JSON object to upload
   * @returns IPFS URI (ipfs://CID)
   */
  async uploadJSON(data: any): Promise<string> {
    if (!this.pinata) {
      throw new Error(
        'Pinata not configured!\n\n' +
        '1. Get free API key from https://pinata.cloud\n' +
        '2. Add to .env.local:\n' +
        '   NEXT_PUBLIC_PINATA_JWT=your_jwt_here\n' +
        '3. Restart dev server'
      );
    }

    try {
      // Upload JSON using @pinata/sdk
      const result = await this.pinata.pinJSONToIPFS(data, {
        pinataMetadata: {
          name: 'movie-metadata.json',
        },
      });
      
      const cid = result.IpfsHash;
      console.log('✅ Uploaded to IPFS:', cid);
      return `ipfs://${cid}`;
    } catch (error) {
      console.error('❌ IPFS upload failed:', error);
      throw new Error(
        `Failed to upload to IPFS: ${error instanceof Error ? error.message : 'Unknown error'}\n\n` +
        'Make sure your Pinata JWT is correct in .env.local'
      );
    }
  }

  /**
   * Upload file (image, poster, etc.) to IPFS
   * @param file - File object from browser input
   * @returns IPFS URI (ipfs://CID)
   */
  async uploadFile(file: File): Promise<string> {
    if (!this.pinata) {
      throw new Error(
        'Pinata not configured!\n\n' +
        '1. Get free API key from https://pinata.cloud\n' +
        '2. Add to .env.local:\n' +
        '   NEXT_PUBLIC_PINATA_JWT=your_jwt_here\n' +
        '3. Restart dev server'
      );
    }

    try {
      // Use Pinata REST API directly for browser File objects
      const formData = new FormData();
      formData.append('file', file);
      
      const metadata = JSON.stringify({
        name: file.name,
      });
      formData.append('pinataMetadata', metadata);

      const response = await fetch('https://api.pinata.cloud/pinning/pinFileToIPFS', {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${process.env.NEXT_PUBLIC_PINATA_JWT}`,
        },
        body: formData,
      });

      if (!response.ok) {
        throw new Error(`Pinata API error: ${response.status} ${response.statusText}`);
      }

      const result = await response.json();
      const cid = result.IpfsHash;
      console.log('✅ Uploaded file to IPFS:', cid, file.name);
      return `ipfs://${cid}`;
    } catch (error) {
      console.error('❌ File upload failed:', error);
      throw new Error(
        `Failed to upload file: ${error instanceof Error ? error.message : 'Unknown error'}`
      );
    }
  }

  /**
   * Retrieve JSON from IPFS
   * @param ipfsURI - IPFS URI (ipfs://CID)
   * @returns Parsed JSON object
   */
  async retrieveJSON(ipfsURI: string): Promise<any> {
    try {
      const url = this.gatewayURL(ipfsURI);
      const response = await fetch(url);
      
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
      }
      
      const data = await response.json();
      return data;
    } catch (error) {
      console.error('❌ Failed to retrieve from IPFS:', ipfsURI, error);
      throw new Error(
        `Failed to retrieve ${ipfsURI}: ${error instanceof Error ? error.message : 'Unknown error'}`
      );
    }
  }

  /**
   * Convert IPFS URI to HTTP gateway URL
   * @param ipfsURI - IPFS URI (ipfs://CID or ipfs://CID/path)
   * @returns HTTP URL via Pinata gateway
   */
  gatewayURL(ipfsURI: string): string {
    const cid = ipfsURI.replace('ipfs://', '');
    
    // Use Pinata dedicated gateway (faster, more reliable)
    if (this.pinata && !this.usePublicGateway) {
      return `https://gateway.pinata.cloud/ipfs/${cid}`;
    }
    
    // Fallback to public IPFS gateway
    return `https://ipfs.io/ipfs/${cid}`;
  }

  /**
   * Test Pinata connection
   * @returns true if connected, false otherwise
   */
  async testConnection(): Promise<boolean> {
    if (!this.pinata) {
      console.error('❌ Pinata not configured');
      return false;
    }

    try {
      await this.pinata.testAuthentication();
      console.log('✅ Pinata connection successful!');
      return true;
    } catch (error) {
      console.error('❌ Pinata connection failed:', error);
      console.error('Check your NEXT_PUBLIC_PINATA_JWT in .env.local');
      return false;
    }
  }
}

// Export singleton instance
export const ipfsService = new IPFSService();

/**
 * Helper: Get Pinata setup instructions
 */
export function getPinataSetupInstructions(): string {
  return `
╔═══════════════════════════════════════════════════════════╗
║  🔧 Pinata Setup Instructions (FREE - 1GB Storage)        ║
╚═══════════════════════════════════════════════════════════╝

Step 1: Create Account
  └─ Visit: https://pinata.cloud
  └─ Click "Start Building for Free"
  └─ Sign up (email or GitHub)

Step 2: Get API Key
  └─ Go to "API Keys" in dashboard
  └─ Click "New Key"
  └─ Select permissions:
      ✅ pinFileToIPFS
      ✅ pinJSONToIPFS  
      ✅ unpin (optional)
  └─ Give it a name (e.g., "Movie Ticketing App")
  └─ Click "Create Key"
  └─ COPY the JWT token (it won't show again!)

Step 3: Add to .env.local
  └─ Open: .env.local in your project
  └─ Add this line:
      NEXT_PUBLIC_PINATA_JWT=your_jwt_token_here
  └─ Replace with your actual JWT

Step 4: Restart
  └─ Stop the dev server (Ctrl+C)
  └─ Run: npm run dev
  └─ Test: Visit theater owner dashboard, upload should work!

Free Tier Limits:
  • 1GB storage (plenty for movie metadata)
  • Unlimited bandwidth
  • 100 pins per month
  • Dedicated gateway access

Need More? Upgrade to paid plans starting at $20/month

Questions? https://docs.pinata.cloud
`;
}

// Log setup status on import
if (typeof window !== 'undefined') {
  const hasJWT = !!process.env.NEXT_PUBLIC_PINATA_JWT;
  if (!hasJWT) {
    console.warn('⚠️ PINATA NOT CONFIGURED');
    console.warn('Follow setup instructions:');
    console.log(getPinataSetupInstructions());
  }
}
